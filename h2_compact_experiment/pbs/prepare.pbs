#!/bin/bash
#PBS -N h2_prepare
#PBS -q cpuq
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
H2_LOG_KIND=prepare H2_THREADS=8
source "$PBS_O_WORKDIR/pbs/common.sh"
export CUDA_VISIBLE_DEVICES=""
unset HF_HUB_OFFLINE TRANSFORMERS_OFFLINE HF_DATASETS_OFFLINE
python -m h2.prepare --config "${H2_CONFIG:-configs/smoke.json}"
