# Copy to settings.env. This is sourced by Bash inside each PBS job.
CONDA_ENV=h2_h100
HF_HOME=/Data4/YOUR_HPC_USER/.hf_cache
# Fill in a CURRENTLY FREE MIG UUID from the cluster's authorized selection procedure.
# The UUID used in an earlier job is not a permanent allocation.
# If PBS already supplies CUDA_VISIBLE_DEVICES=MIG-..., that takes precedence.
MIG_UUID=""
